{
  "name": "ch-weather-app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc",
    "lint-check": "npm run lint:eslint && npm run lint:stylelint && npm run check:prettier",
    "lint:eslint": "eslint \"./src/**/*.{js,jsx,ts,tsx}\"",
    "lint:stylelint": "stylelint \"./src/**/*.{js,jsx,ts,tsx}\"",
    "check:prettier": "prettier --check \"./{public,src}/**/*.{js,jsx,ts,tsx,html,gql,graphql,json,yml}\"",
    "fix": "npm run fix:eslint && npm run fix:stylelint && npm run fix:prettier",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:stylelint": "npm run lint:stylelint -- --fix",
    "fix:prettier": "npm run check:prettier -- --write",
    "prepare": "lefthook install || echo 'Can not set git hooks'"
  },
  "dependencies": {
    "@emotion-icons/material-rounded": "^3.14.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "ky": "^1.14.3",
    "ky-universal": "^0.12.0",
    "next": "^16.4.2",
    "polished": "^4.3.1",
    "postcss": "^8.5.30",
    "postcss-preset-env": "^11.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wicg-inert": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.3",
    "postcss-styled-syntax": "^0.7.4",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
